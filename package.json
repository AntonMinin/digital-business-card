{
  "name": "digital-business-card",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch --env-file .env",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "tsc -p tsconfig.json --outDir .test && node --test \".test/**/*.spec.js\"",
    "db:seed": "node --env-file-if-exists=.env dist/seed.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^16.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "dotenv": "^18.0.5",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3"
  }
}
